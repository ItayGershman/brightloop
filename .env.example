# The keys for a local dev run (scripts/local-run.sh), the same ones the
# scheduled workflow gets from GitHub. Copy to .env (git ignores it) and fill in the values
# yourself; never commit .env. Any key left empty skips its surface, as in a zero-key run.
# One NAME=value per line, the value optionally in quotes; the file is read as data, never run.
# The Google service account JSON goes on one line, as it is.

# Maya's sheet (a secret in GitHub): the service account's JSON key.
GOOGLE_SERVICE_ACCOUNT_JSON=''
# The sheet's id (a variable in GitHub).
SHEET_ID='1HXgiG-YdpvyPeCEomQ_hPWTGilRTM9jP4e01DB9M5Os'
# The #leadership incoming webhook (a secret in GitHub).
SLACK_WEBHOOK_URL=''
# Where the Slack line links (a variable in GitHub). Leave it empty: the line then links to
# Maya's own Sheet, the link she asked for (#13); set an https link only to override that.
DETAILS_URL=''
# A Base44 personal access token with full access to the app (a secret in GitHub).
BASE44_API_KEY=''
# The Base44 app the live page is deployed to (a variable in GitHub).
BASE44_APP_ID='6adb4acd819bb7f711e53ec8'
